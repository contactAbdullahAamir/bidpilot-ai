# Copy to .env (never commit real values). Every variable is optional for local development.

# --- AI orchestrator -------------------------------------------------------
# Set to use Claude for analysis, writing and validation. Without it, the
# deterministic offline engine runs so the product still works end to end.
ANTHROPIC_API_KEY=
# Model routing and cost estimates (USD per million tokens)
BIDPILOT_MODEL=claude-opus-5-5
BIDPILOT_PRICE_INPUT=4
BIDPILOT_PRICE_OUTPUT=20
# Force a provider: "claude", "openai" (any OpenAI-compatible API) or "heuristic"
BIDPILOT_AI_MODE=

# --- Free / OpenAI-compatible models (used when ANTHROPIC_API_KEY is empty) --
# Easiest free option: paste ONE of these keys and leave the rest empty.
#   Google Gemini (free tier):  https://aistudio.google.com/apikey
#   Groq (free tier, fast):     https://console.groq.com/keys
#   OpenRouter (":free" models): https://openrouter.ai/keys
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional overrides. LLM_PROVIDER = gemini | groq | openrouter | ollama | openai
# Ollama runs models locally for free with no key: LLM_PROVIDER=ollama, LLM_MODEL=llama3.1
LLM_PROVIDER=
LLM_MODEL=
# Any other OpenAI-compatible server (vLLM, LM Studio, Together...):
LLM_BASE_URL=
LLM_API_KEY=
# "json_schema" (default) or "json_object" if your server rejects JSON Schema
LLM_RESPONSE_FORMAT=
# Cost estimates in USD per million tokens (0 for free tiers)
LLM_PRICE_INPUT=0
LLM_PRICE_OUTPUT=0

# --- Service-to-service ----------------------------------------------------
# Shared secret between the API and the orchestrator. Change in every deployed environment.
INTERNAL_SERVICE_TOKEN=bidpilot-dev-internal-token
AI_ORCHESTRATOR_URL=http://localhost:8000
API_INTERNAL_URL=http://localhost:3001/api/v1

# --- API -------------------------------------------------------------------
PORT=3001
# Leave empty to use embedded PGlite (stored in apps/api/.data/pglite).
# Set to use PostgreSQL, e.g. the docker-compose database:
DATABASE_URL=
# DATABASE_URL=postgresql://bidpilot:bidpilot@localhost:5432/bidpilot
PGLITE_DIR=
STORAGE_DIR=
WEB_ORIGIN=http://localhost:3000
# Public URL of the web app, used for links in emails (defaults to WEB_ORIGIN)
APP_URL=
# Which proxies to trust for client IPs (rate limiting). Default trusts local/private networks.
TRUST_PROXY=
# Set to "true" only for load tests; disables login/signup/reset rate limits.
RATE_LIMIT_DISABLED=

# --- Email -----------------------------------------------------------------
# Without RESEND_API_KEY, emails (verification, password reset, invitations)
# are printed to the API log so you can click the links in development.
# Resend has a free tier: https://resend.com (verify your domain to email anyone).
RESEND_API_KEY=
MAIL_FROM=BidPilot <onboarding@resend.dev>

# --- Web -------------------------------------------------------------------
# Where the Next.js server proxies /api/v1 requests
API_URL=http://localhost:3001
