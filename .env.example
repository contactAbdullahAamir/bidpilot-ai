# Copy to .env (never commit real values). Every variable is optional for local development.

# --- AI orchestrator -------------------------------------------------------
# Set to use Claude for analysis, writing and validation. Without it, the
# deterministic offline engine runs so the product still works end to end.
ANTHROPIC_API_KEY=
# Model routing and cost estimates (USD per million tokens)
BIDPILOT_MODEL=claude-opus-5-5
BIDPILOT_PRICE_INPUT=4
BIDPILOT_PRICE_OUTPUT=20
# Force a provider: "claude" or "heuristic"
BIDPILOT_AI_MODE=

# --- Service-to-service ----------------------------------------------------
# Shared secret between the API and the orchestrator. Change in every deployed environment.
INTERNAL_SERVICE_TOKEN=bidpilot-dev-internal-token
AI_ORCHESTRATOR_URL=http://localhost:8000
API_INTERNAL_URL=http://localhost:3001/api/v1

# --- API -------------------------------------------------------------------
PORT=3001
# Leave empty to use embedded PGlite (stored in apps/api/.data/pglite).
# Set to use PostgreSQL, e.g. the docker-compose database:
DATABASE_URL=
# DATABASE_URL=postgresql://bidpilot:bidpilot@localhost:5432/bidpilot
PGLITE_DIR=
STORAGE_DIR=
WEB_ORIGIN=http://localhost:3000

# --- Web -------------------------------------------------------------------
# Where the Next.js server proxies /api/v1 requests
API_URL=http://localhost:3001
